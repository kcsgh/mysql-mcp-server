# Copy this file to .env for local testing (docker run --env-file .env ...)
# and set the same values as environment variables / secrets on whatever
# host you deploy to. Never commit a real .env file.

MYSQL_HOST=your-rds-endpoint.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=readonly_user
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=car_rental_original
MYSQL_SSL=true

# Long, random shared secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# This exact value goes in Claude's connector "Advanced settings" as the
# bearer token.
AUTH_TOKEN=change-me-to-a-long-random-string

# Optional ChatGPT OAuth. Leave all unset for the existing Claude-only mode.
# Use an external OAuth 2.1 provider with RS256 JWT access tokens.
# Issuer must match the token's iss exactly, including any trailing slash.
# OAUTH_ISSUER=https://identity.example.com/
# OAUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# Canonical public MCP URL; access tokens must contain this exact audience.
# OAUTH_RESOURCE_URL=https://your-server.example.com/mcp
# OAUTH_REQUIRED_SCOPES=mysql:read
